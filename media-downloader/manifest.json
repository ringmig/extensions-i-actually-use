{
  "manifest_version": 3,
  "name": "Media Downloader",
  "version": "1.5.0",
  "key": "",
  "description": "Right-click to download media from Instagram, TikTok, YouTube, Twitter/X, Facebook, and more.",
  "permissions": [
    "contextMenus",
    "downloads",
    "offscreen",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "toast.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
