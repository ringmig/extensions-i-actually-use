{
  "manifest_version": 3,
  "name": "GIF Recorder",
  "version": "1.0",
  "description": "Right-click to select and record any area of a page as an animated GIF",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["contextMenus", "activeTab", "scripting", "downloads", "tabCapture"],
  "host_permissions": ["<all_urls>"],
  "action": {},
  "background": {
    "service_worker": "background.js"
  }
}
