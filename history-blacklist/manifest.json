{
  "manifest_version": 3,
  "name": "Unhistory",
  "version": "1.0",
  "description": "Keeps the keywords and URLs you list out of your browser history and address-bar suggestions.",
  "permissions": [
    "history",
    "webNavigation",
    "storage",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
