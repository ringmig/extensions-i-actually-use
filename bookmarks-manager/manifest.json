{
  "manifest_version": 3,
  "name": "Bookmarks Manager",
  "version": "1.1",
  "description": "Minimalistic dark bookmarks manager with site previews",
  "icons": {
    "16": "chrome.svg",
    "32": "chrome.svg",
    "48": "chrome.svg",
    "128": "chrome.svg"
  },
  "permissions": ["bookmarks", "favicon", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
